{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.length === 6 && $room.matches(/^[a-z0-9]+$/)",
        "$role": {
          ".write": "$room.length === 6 && $room.matches(/^[a-z0-9]+$/) && ($role === 'go' || $role === 'jump')",
          ".validate": "newData.hasChildren(['owner'])",
          "owner": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "down": {
            ".validate": "newData.isBoolean()"
          },
          "n": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
